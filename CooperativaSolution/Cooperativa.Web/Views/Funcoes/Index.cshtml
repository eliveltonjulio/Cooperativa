@model IEnumerable<Cooperativa.Models.Funcao>
@{
    ViewData["Title"] = "Funções";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Funções</h2>
        <p class="text-muted mb-0">Gerencie as funções disponíveis para as alocações.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nova função</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome, descrição ou CBO" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary w-100">Filtrar</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-outline-light text-dark w-100">Limpar</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>CBO</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Descricao</td>
                <td>@(string.IsNullOrWhiteSpace(item.Cbo) ? "-" : item.Cbo)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
