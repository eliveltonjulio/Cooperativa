@model IEnumerable<Cooperativa.Models.RegraHoraExtra>
@{ ViewData["Title"] = "Regras de hora extra"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">Regras de hora extra</h2><p class="text-muted mb-0">Defina os percentuais de hora extra por contrato.</p></div><a asp-action="Create" class="btn btn-primary">Nova regra</a></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-8"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por contrato" /></div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
    <div class="col-md-2"><a asp-action="Index" class="btn btn-outline-light text-dark w-100">Limpar</a></div>
</form>
<table class="table table-striped">
    <thead><tr><th>Contrato (empresa)</th><th>% HE comum</th><th>% HE domingo/feriado</th><th>Ações</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Contrato?.EmpresaNome ?? "Todas as empresas")</td>
            <td>@item.PercentualHeComum.ToString("0.00")%</td>
            <td>@item.PercentualHeDomingoFeriado.ToString("0.00")%</td>
            <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalhes</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a></td>
        </tr>
    }
    </tbody>
</table>
