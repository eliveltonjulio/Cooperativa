@model Cooperativa.Models.TipoAdicional
@{
    ViewData["Title"] = "Detalhes do tipo de adicional";
}

<div class="card p-4">
    <h2 class="mb-3">Detalhes do tipo de adicional</h2>
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>
        <dt class="col-sm-3">Tipo de cálculo</dt>
        <dd class="col-sm-9">@Model.TipoCalculo</dd>
        <dt class="col-sm-3">Valor</dt>
        <dd class="col-sm-9">@Model.Valor.ToString("0.00")</dd>
    </dl>
    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <button type="button" onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</button>
    </div>
</div>
