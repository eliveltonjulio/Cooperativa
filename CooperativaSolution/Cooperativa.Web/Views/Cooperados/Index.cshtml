@model IEnumerable<Cooperativa.Models.Cooperado>

@{
    ViewData["Title"] = "Cooperados";
    var ehCooperado = User.IsInRole("Cooperado") && !User.IsInRole("Administrador") && !User.IsInRole("Admin") && !User.IsInRole("Coordenador") && !User.IsInRole("Gestor");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Cooperados</h2>
        <p class="text-muted mb-0">Consulta, cadastro, edição e exclusão de cooperados.</p>
    </div>
    @if (!ehCooperado)
    {
        <a class="btn btn-primary" href="/Cooperados/Create">Novo cooperado</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome, CPF ou e-mail" />
    </div>
    <div class="col-md-4">
        <select name="status" class="form-select">
            <option value="todos" selected="@(ViewBag.Status == null || ViewBag.Status == "todos")">Todos</option>
            <option value="ativo" selected="@(ViewBag.Status == "ativo")">Ativos</option>
            <option value="inativo" selected="@(ViewBag.Status == "inativo")">Inativos</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum cooperado cadastrado ainda.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>E-mail</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cooperado in Model)
                    {
                        <tr>
                            <td>@cooperado.Nome</td>
                            <td>@cooperado.CPF</td>
                            <td>@cooperado.Email</td>
                            <td><span class="badge @(cooperado.Ativo ? "bg-success" : "bg-secondary")">@(cooperado.Ativo ? "Ativo" : "Inativo")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Cooperados" asp-action="Details" asp-route-id="@cooperado.Id">Detalhes</a>
                                @if (!ehCooperado)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@cooperado.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@cooperado.Id">Excluir</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
