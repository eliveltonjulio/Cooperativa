@model Cooperativa.Models.DespesaFolha
@{ ViewData["Title"] = "Nova despesa da folha"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">Nova despesa da folha</h2><p class="text-muted mb-0">Cadastre um desconto como percentual ou valor fixo.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
<form asp-action="Create" method="post" class="card border-0 shadow-sm p-4">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" placeholder="Ex.: INSS" /></div>
        <div class="col-md-6"><label asp-for="TipoCalculo" class="form-label"></label><select asp-for="TipoCalculo" class="form-select"><option value="PERCENTUAL_REMUNERACAO">Percentual da remuneração mensal</option><option value="VALOR_FIXO">Valor fixo</option></select></div>
        <div class="col-md-6"><label asp-for="Valor" class="form-label">Valor / percentual</label><input asp-for="Valor" class="form-control" type="number" step="0.01" min="0" /></div>
        <div class="col-md-6"><label asp-for="TetoRetencao" class="form-label"></label><input asp-for="TetoRetencao" class="form-control" type="number" step="0.01" min="0" placeholder="Ex.: teto do INSS" /></div>
        <div class="col-md-6 form-check ms-2"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Despesa ativa</label></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-success">Salvar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form>
