@model Cooperativa.Models.JornadaContratual
@{
    ViewData["Title"] = "Detalhes da jornada contratual";
    var outrasJornadas = ViewBag.OutrasJornadas as List<Cooperativa.Models.JornadaContratual> ?? new List<Cooperativa.Models.JornadaContratual> { Model };
    static string FormatarDias(int diasSemana)
    {
        var nomes = Cooperativa.Models.DiaSemanaFlags.Todos
            .Where(d => (diasSemana & d.Valor) == d.Valor)
            .Select(d => d.Nome);
        return string.Join(", ", nomes);
    }
}
<div class="card p-4">
    <h2 class="mb-3">Detalhes da jornada contratual</h2>
    <dl class="row mb-4">
        <dt class="col-sm-3">Contrato (empresa)</dt><dd class="col-sm-9"><strong>@Model.Contrato?.EmpresaNome</strong></dd>
        <dt class="col-sm-3">Função</dt><dd class="col-sm-9"><strong>@Model.Funcao?.Nome</strong></dd>
    </dl>

    <h5 class="text-primary mb-3"><i class="bi bi-clock-history me-2"></i>Escala de Horários Cadastrada</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>Dias da semana</th>
                    <th>Início</th>
                    <th>Fim</th>
                    <th>Intervalo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in outrasJornadas)
                {
                    <tr>
                        <td><strong>@FormatarDias(j.DiasSemana)</strong></td>
                        <td>@j.HoraInicio.ToString(@"hh\:mm")</td>
                        <td>@j.HoraFim.ToString(@"hh\:mm")</td>
                        <td>@(j.HoraInicioIntervalo.HasValue ? $"{j.HoraInicioIntervalo:hh\\:mm} às {j.HoraFimIntervalo:hh\\:mm}" : "Sem intervalo cadastrado")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <button type="button" onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</button>
    </div>
</div>
