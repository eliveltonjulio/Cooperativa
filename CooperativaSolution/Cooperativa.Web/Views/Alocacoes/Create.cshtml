@model Cooperativa.Models.Alocacao
@{
    ViewData["Title"] = "Nova alocação";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Nova alocação</h2>
        <p class="text-muted mb-0">Vincule um cooperado a um contrato e a uma função.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<form asp-action="Create" method="post" class="card border-0 shadow-sm p-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Cooperado</label>
            <select asp-for="CooperadoId" class="form-select">
                <option value="">Selecione...</option>
                @if (ViewBag.Cooperados is IEnumerable<Cooperativa.Models.Cooperado> cooperados)
                {
                    @foreach (var cooperado in cooperados)
                    {
                        <option value="@cooperado.Id">@cooperado.Nome</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Contrato</label>
            <select asp-for="ContratoId" class="form-select">
                <option value="">Selecione...</option>
                @if (ViewBag.Contratos is IEnumerable<Cooperativa.Models.Contrato> contratos)
                {
                    @foreach (var contrato in contratos)
                    {
                        <option value="@contrato.Id">@contrato.EmpresaNome</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Função</label>
            <select asp-for="FuncaoId" class="form-select">
                <option value="">Selecione...</option>
                @if (ViewBag.Funcoes is IEnumerable<Cooperativa.Models.Funcao> funcoes)
                {
                    @foreach (var funcao in funcoes)
                    {
                        <option value="@funcao.Id">@funcao.Nome</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="DataInicio" class="form-label"></label>
            <input asp-for="DataInicio" class="form-control" type="date" />
        </div>
        <div class="col-md-6">
            <label asp-for="DataFim" class="form-label"></label>
            <input asp-for="DataFim" class="form-control" type="date" />
            <div class="form-text">Opcional: deixe em branco para alocação em aberto.</div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
