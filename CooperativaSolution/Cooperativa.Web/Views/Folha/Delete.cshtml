@model Cooperativa.Models.FolhaPagamento

@{
    ViewData["Title"] = "Excluir folha";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Excluir folha</h2>
        <p class="text-muted mb-0">Confirme a remoção da folha.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<div class="alert alert-warning">
    Tem certeza que deseja excluir a folha de <strong>@Model.Cooperado?.Nome</strong>?
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p><strong>Competência:</strong> @Model.Competencia.ToString("MM/yyyy")</p>
        <p><strong>Líquido:</strong> @Model.Liquido.ToString("C")</p>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
