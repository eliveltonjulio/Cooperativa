@model Cooperativa.Models.Cooperado

@{
    ViewData["Title"] = "Excluir cooperado";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Excluir cooperado</h2>
        <p class="text-muted mb-0">Confirme a remoção do associado.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<div class="alert alert-warning">
    Tem certeza que deseja excluir o cooperado <strong>@Model.Nome</strong>?
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p><strong>CPF:</strong> @Model.CPF</p>
        <p><strong>E-mail:</strong> @Model.Email</p>

        <form asp-controller="Cooperados" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
