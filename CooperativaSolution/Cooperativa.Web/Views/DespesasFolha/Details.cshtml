@model Cooperativa.Models.DespesaFolha
@{ ViewData["Title"] = "Detalhes da despesa"; }
<div class="card p-4"><h2 class="mb-3">Detalhes da despesa da folha</h2><dl class="row"><dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd><dt class="col-sm-3">Tipo de cálculo</dt><dd class="col-sm-9">@(Model.TipoCalculo == "VALOR_FIXO" ? "Valor fixo" : "Percentual da remuneração mensal")</dd><dt class="col-sm-3">Valor</dt><dd class="col-sm-9">@Model.Valor.ToString("0.00")@(Model.TipoCalculo == "PERCENTUAL_REMUNERACAO" ? "%" : "")</dd><dt class="col-sm-3">Teto de retenção</dt><dd class="col-sm-9">@(Model.TetoRetencao?.ToString("C") ?? "Não informado")</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Ativo ? "Ativa" : "Inativa")</dd></dl><div class="mt-4 d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a><button type="button" onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</button></div></div>
