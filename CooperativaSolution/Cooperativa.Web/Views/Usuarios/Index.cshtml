@model IEnumerable<Cooperativa.Models.Usuario>
@{
    ViewData["Title"] = "Gestão de Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Usuários do Sistema</h2>
        <p class="text-muted mb-0">Gerencie identificação, contato, perfis de acesso e informações funcionais.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Novo usuário</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome, login, email, equipe..." />
    </div>
    <div class="col-md-3">
        <select name="perfil" class="form-select">
            <option value="todos">Todos os perfis</option>
            <option value="Administrador" selected="@(ViewBag.Perfil == "Administrador")">Administrador</option>
            <option value="Coordenador" selected="@(ViewBag.Perfil == "Coordenador")">Coordenador</option>
            <option value="Cooperado" selected="@(ViewBag.Perfil == "Cooperado")">Cooperado</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="todos">Todos os status</option>
            <option value="ativo" selected="@(ViewBag.Status == "ativo")">Ativos</option>
            <option value="inativo" selected="@(ViewBag.Status == "inativo")">Inativos</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary w-100"><i class="bi bi-search me-1"></i>Filtrar</button>
    </div>
    <div class="col-md-1">
        <a asp-action="Index" class="btn btn-outline-light text-dark w-100" title="Limpar filtros">Limpar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Nome / Login</th>
                <th>Contato</th>
                <th>Perfil</th>
                <th>Equipe / Cargo</th>
                <th>Status</th>
                <th>Último Acesso</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="fw-bold">@item.Nome</div>
                        <small class="text-muted font-monospace"><i class="bi bi-person-badge me-1"></i>@item.Login</small>
                    </td>
                    <td>
                        <div><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                        @if (!string.IsNullOrWhiteSpace(item.Celular))
                        {
                            <small class="text-muted"><i class="bi bi-telephone me-1"></i>@item.Celular</small>
                        }
                    </td>
                    <td>
                        @if (item.Perfil == "Administrador")
                        {
                            <span class="badge bg-danger"><i class="bi bi-shield-lock me-1"></i>Administrador (MFA)</span>
                        }
                        else if (item.Perfil == "Coordenador")
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-person-gear me-1"></i>Coordenador</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark"><i class="bi bi-person me-1"></i>Cooperado</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.Equipe))
                        {
                            <div class="badge bg-light text-dark border"><i class="bi bi-people me-1"></i>@item.Equipe</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Cargo))
                        {
                            <div><small class="text-muted">@item.Cargo</small></div>
                        }
                    </td>
                    <td>
                        @if (item.Ativo)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inativo</span>
                        }
                    </td>
                    <td>
                        <small class="text-muted">
                            @(item.UltimoAcesso.HasValue ? item.UltimoAcesso.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca acessou")
                        </small>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalhes"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
