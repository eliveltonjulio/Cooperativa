@model Cooperativa.Models.ApuracaoPontoMensal
@{ ViewData["Title"] = "Excluir apuração mensal"; }
<div class="card p-4"><h2 class="mb-3">Excluir apuração mensal</h2><p>Confirma a exclusão da apuração de <strong>@Model.Cooperado?.Nome</strong> em <strong>@Model.MesAno.ToString("MM/yyyy")</strong>?</p><form asp-action="Delete" method="post"><input type="hidden" name="cooperadoId" value="@Model.CooperadoId" /><input type="hidden" name="mesAno" value="@Model.MesAno.ToString("yyyy-MM-dd")" /><div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-danger">Excluir</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form></div>
