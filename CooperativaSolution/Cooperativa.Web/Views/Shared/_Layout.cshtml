<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cooperativa</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
</head>
<body class="bg-light">
    @{
        var ehAdmin = User.IsInRole("Administrador") || User.IsInRole("Admin") || !User.Identity?.IsAuthenticated == true;
        var ehCoordenador = User.IsInRole("Coordenador") || User.IsInRole("Gestor");
        var ehCooperado = User.IsInRole("Cooperado") || User.IsInRole("Operacional");
        var nomeUsuario = User.FindFirst("NomeCompleto")?.Value ?? User.Identity?.Name ?? "Visitante";
        var perfilExibicao = User.FindFirst("PerfilExibicao")?.Value ?? (ehAdmin ? "Administrador" : ehCoordenador ? "Coordenador" : "Cooperado");
        var cooperadoIdClaim = User.FindFirst("CooperadoId")?.Value;
        // Cooperado puro (sem papel administrativo): acesso restrito ao próprio cadastro/ponto.
        var ehCooperadoRestrito = ehCooperado && !ehAdmin && !ehCoordenador;
    }
    <div class="d-flex">
        <aside class="bg-dark text-white p-3" style="min-height:100vh; width:260px;">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="rounded-circle bg-success p-2"><i class="bi bi-shield-check text-white"></i></div>
                <div>
                    <h4 class="fw-bold mb-0">Cooperativa</h4>
                    <div class="text-white-50 small">Gestão administrativa</div>
                </div>
            </div>
            <ul class="nav flex-column gap-1">
                <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Página Principal</a></li>
                @if (!ehCooperadoRestrito)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Cooperados" asp-action="Index"><i class="bi bi-people me-2"></i>Cooperados</a></li>
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Contratos" asp-action="Index"><i class="bi bi-file-earmark-text me-2"></i>Contratos</a></li>
                }
                else if (!string.IsNullOrWhiteSpace(cooperadoIdClaim))
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Cooperados" asp-action="Details" asp-route-id="@cooperadoIdClaim"><i class="bi bi-person-vcard me-2"></i>Meu Cadastro</a></li>
                }

                @if (ehAdmin || ehCoordenador)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Funcoes" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Funções</a></li>
                }

                @if (ehAdmin || ehCoordenador)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Remuneracoes" asp-action="Index"><i class="bi bi-wallet2 me-2"></i>Remunerações</a></li>
                }

                @if (ehAdmin || ehCoordenador)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="JornadasContratuais" asp-action="Index"><i class="bi bi-calendar2-week me-2"></i>Jornada Contratual</a></li>
                }

                @if (ehAdmin || ehCoordenador)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Alocacoes" asp-action="Index"><i class="bi bi-diagram-3 me-2"></i>Alocações</a></li>
                }

                <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Ponto" asp-action="Index"><i class="bi bi-clock me-2"></i>Ponto</a></li>

                @if (ehAdmin || ehCoordenador)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Home" asp-action="Gestao"><i class="bi bi-briefcase me-2"></i>Gestão</a></li>
                }

                @if (ehAdmin)
                {
                    <li class="nav-item"><a class="nav-link text-white rounded px-3 py-2" asp-controller="Home" asp-action="Parametrizacao"><i class="bi bi-sliders me-2"></i>Parametrização</a></li>
                }

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <li class="nav-item mt-3"><a class="nav-link bg-primary text-white rounded px-3 py-2" asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-right me-2"></i>Fazer Login</a></li>
                }
            </ul>
        </aside>

        <main class="flex-grow-1 p-4">
            <header class="border-0 mb-4 pb-3 d-flex justify-content-between align-items-center bg-white rounded p-3 shadow-sm">
                <div>
                    <h4 class="mb-0 text-dark fw-bold">Sistema Cooperativo</h4>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <small class="text-muted">
                            <i class="bi bi-person-circle me-1"></i><strong>@nomeUsuario</strong> | Perfil: <span class="badge bg-secondary">@perfilExibicao</span>
                        </small>
                    }
                    else
                    {
                        <small class="text-muted">Usuário não autenticado</small>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-2"><i class="bi bi-circle-fill me-1"></i>Conectado</span>
                        <a class="btn btn-outline-secondary btn-sm px-3" asp-controller="Auth" asp-action="AlterarSenha" title="Alterar minha senha">
                            <i class="bi bi-key me-1"></i>Alterar senha
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm px-3"><i class="bi bi-box-arrow-right me-1"></i>Sair</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm px-3" asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Entrar</a>
                    }
                </div>
            </header>

            @if (TempData["MensagemSucesso"] is string sucesso)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@sucesso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["MensagemErro"] is string erro)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@erro
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
