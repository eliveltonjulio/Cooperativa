@model IEnumerable<Cooperativa.Models.ApuracaoPontoMensal>
@{ ViewData["Title"] = "Apuração mensal de ponto"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">Apuração mensal de ponto</h2><p class="text-muted mb-0">Totalizadores mensais para cálculo da remuneração.</p></div><a asp-action="Create" class="btn btn-primary">Nova apuração</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por cooperado" /></div><div class="col-md-3"><input name="mesAno" value="@ViewBag.MesAno" class="form-control" type="month" /></div><div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div><div class="col-md-2"><a asp-action="Index" class="btn btn-outline-light text-dark w-100">Limpar</a></div></form>
<table class="table table-striped"><thead><tr><th>Cooperado</th><th>Mês/ano</th><th>Horas normais</th><th>Horas extras</th><th>Horas noturnas</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model){<tr><td>@item.Cooperado?.Nome</td><td>@item.MesAno.ToString("MM/yyyy")</td><td>@item.QtdHorasNormais.ToString("0.00")</td><td>@item.QtdHorasExtras.ToString("0.00")</td><td>@item.QtdHorasNoturnas.ToString("0.00")</td><td><a asp-action="Details" asp-route-cooperadoId="@item.CooperadoId" asp-route-mesAno="@item.MesAno.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-info">Detalhes</a> <a asp-action="Edit" asp-route-cooperadoId="@item.CooperadoId" asp-route-mesAno="@item.MesAno.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-warning">Editar</a> <a asp-action="Delete" asp-route-cooperadoId="@item.CooperadoId" asp-route-mesAno="@item.MesAno.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-danger">Excluir</a></td></tr>}</tbody></table>
