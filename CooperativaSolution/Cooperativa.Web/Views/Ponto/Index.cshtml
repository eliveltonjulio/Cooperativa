@model IEnumerable<Cooperativa.Models.RegistroPonto>

@{
    ViewData["Title"] = "Ponto";
    var ehCooperado = User.IsInRole("Cooperado") && !User.IsInRole("Administrador") && !User.IsInRole("Admin") && !User.IsInRole("Coordenador") && !User.IsInRole("Gestor");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">@(ehCooperado ? "Meu Registro de Ponto" : "Registro de Ponto")</h2>
        <p class="text-muted mb-0">@(ehCooperado ? "Consulte o histórico dos seus registros de ponto." : "Acompanhe os registros de entrada e saída.")</p>
    </div>
    @if (!ehCooperado)
    {
        <a class="btn btn-success" asp-action="Create">Novo registro</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por cooperado ou observação" />
    </div>
    <div class="col-md-2">
        <select name="contratoId" class="form-select" title="Contrato">
            <option value="">Todos os contratos</option>
            @if (ViewBag.Contratos is IEnumerable<Cooperativa.Models.Contrato> contratos)
            {
                @foreach (var contrato in contratos)
                {
                    <option value="@contrato.Id" selected="@(ViewBag.ContratoId is Guid contratoSelecionado && contratoSelecionado == contrato.Id)">@contrato.EmpresaNome</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="ocorrencia" class="form-select" title="Ocorrência">
            <option value="">Todas as ocorrências</option>
            @foreach (var ocorrenciaItem in Cooperativa.Models.OcorrenciasPonto.Todas)
            {
                <option value="@ocorrenciaItem.Codigo" selected="@(ViewBag.Ocorrencia as string == ocorrenciaItem.Codigo)">@ocorrenciaItem.Descricao</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="data" value="@ViewBag.Data" class="form-control" title="Data do registro" />
    </div>
    <div class="col-md-2">
        <input type="month" name="competencia" value="@ViewBag.Competencia" class="form-control" title="Competência (mês/ano)" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-success">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum registro de ponto cadastrado.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Cooperado</th>
                        <th>Ocorrência</th>
                        <th>Entrada</th>
                        <th>Saída</th>
                        <th>Início do intervalo</th>
                        <th>Fim do intervalo</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registro in Model)
                    {
                        <tr>
                            <td>@registro.Data.ToString("dd/MM/yyyy")</td>
                            <td>@registro.Cooperado?.Nome</td>
                            <td>@(Cooperativa.Models.OcorrenciasPonto.ObterPorCodigo(registro.Ocorrencia)?.Descricao ?? "-")</td>
                            <td>@(registro.Entrada?.ToString("HH:mm") ?? "-")</td>
                            <td>@(registro.Saida?.ToString("HH:mm") ?? "-")</td>
                            <td>@(registro.InicioIntervalo?.ToString("HH:mm") ?? "-")</td>
                            <td>@(registro.FimIntervalo?.ToString("HH:mm") ?? "-")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@registro.Id">Detalhes</a>
                                @if (!ehCooperado)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@registro.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@registro.Id">Excluir</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
            </table>
        </div>
    </div>
}
