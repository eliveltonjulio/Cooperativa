@model Cooperativa.Models.ContratoFuncaoAdicional
@{
    ViewData["Title"] = "Excluir vínculo de adicional";
}

<div class="card p-4">
    <h2 class="mb-3">Excluir vínculo de adicional</h2>
    <p>Confirma a exclusão do adicional <strong>@Model.Adicional?.Nome</strong> para a função <strong>@Model.Funcao?.Nome</strong> do contrato <strong>@Model.Contrato?.EmpresaNome</strong>?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="contratoId" value="@Model.ContratoId" />
        <input type="hidden" name="funcaoId" value="@Model.FuncaoId" />
        <input type="hidden" name="adicionalId" value="@Model.AdicionalId" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
