@model Cooperativa.Models.RegistroPonto

@{
    ViewData["Title"] = "Cadastrar ponto";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Cadastrar ponto</h2>
        <p class="text-muted mb-0">Registre entrada, saída, ocorrência e observações.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<form asp-action="Create" method="post" class="card border-0 shadow-sm p-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="contratoId">Contrato (empresa)</label>
            <select id="contratoId" name="contratoId" class="form-select" required data-valor-inicial="@ViewData["ContratoId"]">
                <option value="">Selecione primeiro o contrato...</option>
                @if (ViewBag.Contratos is IEnumerable<Cooperativa.Models.Contrato> contratos)
                {
                    @foreach (var contrato in contratos)
                    {
                        <option value="@contrato.Id">@contrato.EmpresaNome</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Cooperado</label>
            <select asp-for="CooperadoId" id="CooperadoId" class="form-select" required disabled data-valor-inicial="@Model.CooperadoId">
                <option value="">Selecione primeiro o contrato...</option>
            </select>
            <span asp-validation-for="CooperadoId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Data" class="form-label"></label>
            <input asp-for="Data" class="form-control" type="date" id="dataPonto" />
            <span asp-validation-for="Data" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Ocorrencia" class="form-label"></label>
            <select asp-for="Ocorrencia" id="Ocorrencia" class="form-select">
                <option value="">Nenhuma (dia trabalhado comum)</option>
                @foreach (var ocorrencia in Cooperativa.Models.OcorrenciasPonto.Todas)
                {
                    <option value="@ocorrencia.Codigo" data-impacto="@ocorrencia.TipoImpactoFolha">@ocorrencia.Descricao (@ocorrencia.Codigo)</option>
                }
            </select>
            <span asp-validation-for="Ocorrencia" class="text-danger"></span>
            <small id="ocorrenciaImpacto" class="text-muted d-block mt-1">Sem ocorrência: registro comum de jornada trabalhada.</small>
        </div>
        <div class="col-md-6">
            <label asp-for="Entrada" class="form-label"></label>
            <input asp-for="Entrada" class="form-control" type="time" />
        </div>
        <div class="col-md-6">
            <label asp-for="Saida" class="form-label"></label>
            <input asp-for="Saida" class="form-control" type="time" />
        </div>
        <div class="col-md-6">
            <label asp-for="InicioIntervalo" class="form-label"></label>
            <input asp-for="InicioIntervalo" class="form-control" type="time" />
        </div>
        <div class="col-md-6">
            <label asp-for="FimIntervalo" class="form-label"></label>
            <input asp-for="FimIntervalo" class="form-control" type="time" />
        </div>
        <div class="col-12">
            <label asp-for="Observacao" class="form-label"></label>
            <textarea asp-for="Observacao" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

<script>
    (function () {
        var alocacoes = @Html.Raw(ViewBag.AlocacoesJson ?? "[]");
        var contratoSelect = document.getElementById('contratoId');
        var cooperadoSelect = document.getElementById('CooperadoId');
        var dataInput = document.getElementById('dataPonto');

        function carregarCooperados(selecaoParaRestaurar) {
            var contratoValor = contratoSelect.value;
            var data = dataInput.value;
            // Valor a re-selecionar após reconstruir a lista; vazio = "Selecione...".
            var restaurar = selecaoParaRestaurar || '';

            cooperadoSelect.innerHTML = '';
            cooperadoSelect.appendChild(new Option('Selecione...', ''));

            if (!contratoValor) {
                cooperadoSelect.disabled = true;
                cooperadoSelect.firstChild.textContent = 'Selecione primeiro o contrato...';
                return;
            }

            var itens = alocacoes.filter(function (a) { return a.contratoId === contratoValor; });
            if (data) {
                itens = itens.filter(function (a) {
                    return (!a.inicio || a.inicio <= data) && (!a.fim || a.fim >= data);
                });
            }

            var unicos = {};
            itens.forEach(function (a) { unicos[a.cooperadoId] = a.nome; });
            var ids = Object.keys(unicos).sort(function (x, y) { return unicos[x].localeCompare(unicos[y]); });

            ids.forEach(function (id) {
                cooperadoSelect.appendChild(new Option(unicos[id], id));
            });

            if (ids.length === 0) {
                cooperadoSelect.disabled = true;
                cooperadoSelect.firstChild.textContent = data
                    ? 'Nenhum cooperado alocado neste contrato nesta data'
                    : 'Nenhum cooperado alocado neste contrato';
            } else {
                cooperadoSelect.disabled = false;
                if (restaurar && ids.indexOf(restaurar) !== -1) {
                    cooperadoSelect.value = restaurar;
                }
            }
        }

        contratoSelect.addEventListener('change', function () {
            // Troca de contrato exige selecionar o cooperado novamente (listas diferentes).
            carregarCooperados('');
        });

        dataInput.addEventListener('change', function () {
            // Preserva o cooperado já escolhido quando a data muda — antes desta
            // mudança a seleção era descartada e o usuário precisava escolher de novo.
            carregarCooperados(cooperadoSelect.value);
        });

        if (contratoSelect.dataset.valorInicial && contratoSelect.querySelector('option[value="' + contratoSelect.dataset.valorInicial + '"]')) {
            contratoSelect.value = contratoSelect.dataset.valorInicial;
        }
        carregarCooperados(cooperadoSelect.dataset.valorInicial || cooperadoSelect.value);
    })();
</script>

<script>
    (function () {
        var ocorrenciaSelect = document.getElementById('Ocorrencia');
        var ocorrenciaImpacto = document.getElementById('ocorrenciaImpacto');
        if (!ocorrenciaSelect || !ocorrenciaImpacto) return;

        function atualizarImpacto() {
            var opcao = ocorrenciaSelect.options[ocorrenciaSelect.selectedIndex];
            var impacto = opcao && opcao.dataset.impacto ? opcao.dataset.impacto : null;
            ocorrenciaImpacto.textContent = impacto
                ? 'Impacto na folha: ' + impacto + '.'
                : 'Sem ocorrência: registro comum de jornada trabalhada.';
        }

        ocorrenciaSelect.addEventListener('change', atualizarImpacto);
        atualizarImpacto();
    })();
</script>
