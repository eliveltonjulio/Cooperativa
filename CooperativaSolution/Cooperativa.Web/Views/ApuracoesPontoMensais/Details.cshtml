@model Cooperativa.Models.ApuracaoPontoMensal
@{ ViewData["Title"] = "Detalhes da apuração mensal"; }
<div class="card p-4"><h2 class="mb-3">Detalhes da apuração mensal</h2><dl class="row"><dt class="col-sm-3">Cooperado</dt><dd class="col-sm-9">@Model.Cooperado?.Nome</dd><dt class="col-sm-3">Mês/ano</dt><dd class="col-sm-9">@Model.MesAno.ToString("MM/yyyy")</dd><dt class="col-sm-3">Horas normais</dt><dd class="col-sm-9">@Model.QtdHorasNormais.ToString("0.00")</dd><dt class="col-sm-3">Horas extras</dt><dd class="col-sm-9">@Model.QtdHorasExtras.ToString("0.00")</dd><dt class="col-sm-3">Horas noturnas</dt><dd class="col-sm-9">@Model.QtdHorasNoturnas.ToString("0.00")</dd></dl><div class="mt-4 d-flex gap-2"><a asp-action="Edit" asp-route-cooperadoId="@Model.CooperadoId" asp-route-mesAno="@Model.MesAno.ToString("yyyy-MM-dd")" class="btn btn-warning">Editar</a><button type="button" onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</button></div></div>
