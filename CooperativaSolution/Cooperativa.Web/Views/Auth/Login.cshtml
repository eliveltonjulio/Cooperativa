@model Cooperativa.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <div class="d-inline-block rounded-circle bg-success text-white p-3 mb-2 shadow-sm">
                <i class="bi bi-shield-lock fs-2"></i>
            </div>
            <h3 class="fw-bold text-dark">Cooperativa</h3>
            <p class="text-muted small">Informe suas credenciais para acessar o sistema</p>
        </div>

        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Login" class="form-label fw-semibold">Usuário ou E-mail</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input asp-for="Login" class="form-control" placeholder="Seu login ou e-mail" autofocus />
                    </div>
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Senha" class="form-label fw-semibold mb-0">Senha</label>
                        <a asp-action="EsqueciSenha" class="small text-decoration-none text-primary">Esqueci minha senha</a>
                    </div>
                    <div class="input-group mt-1">
                        <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                        <input asp-for="Senha" class="form-control" type="password" placeholder="Sua senha de acesso" />
                    </div>
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-semibold mt-2 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Entrar no Sistema
                </button>
            </form>
        </div>

        <div class="text-center mt-3 text-muted small">
            <span>Perfis de acesso: Administrador, Coordenador, Cooperado</span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
