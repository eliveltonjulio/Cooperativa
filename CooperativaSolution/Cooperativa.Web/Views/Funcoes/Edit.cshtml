@model Cooperativa.Models.Funcao
@{
    ViewData["Title"] = "Editar função";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Editar função</h2>
        <p class="text-muted mb-0">Atualize os dados da função.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm p-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" placeholder="Ex.: Analista de Sistemas" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cbo" class="form-label"></label>
            <input asp-for="Cbo" id="Cbo" class="form-control" inputmode="numeric" placeholder="0000-00" maxlength="10" autocomplete="off" />
            <div class="form-text">CBO - Classificação Brasileira de Ocupações (ex.: 2124-05). Campo opcional.</div>
            <span asp-validation-for="Cbo" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Descricao" class="form-label"></label>
            <input asp-for="Descricao" class="form-control" placeholder="Descreva as atividades da função" />
            <span asp-validation-for="Descricao" class="text-danger small"></span>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const campo = document.getElementById('Cbo');
            if (!campo) return;

            const formatarCbo = (valor) => {
                const digitos = valor.replace(/\D/g, '').slice(0, 6);
                return digitos.length > 4 ? `${digitos.slice(0, 4)}-${digitos.slice(4)}` : digitos;
            };

            campo.addEventListener('input', () => { campo.value = formatarCbo(campo.value); });
        })();
    </script>
}
