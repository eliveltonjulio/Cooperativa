<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Cooperativa.Application\Cooperativa.Application.csproj" />
    <ProjectReference Include="..\Cooperativa.Infrastructure\Cooperativa.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <UseAppHost>false</UseAppHost>
    <CopyRazorGenerateFilesToOutputDirectory>true</CopyRazorGenerateFilesToOutputDirectory>
    <CopyRazorFilesToOutputDirectory>true</CopyRazorFilesToOutputDirectory>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
  </PropertyGroup>



</Project>
