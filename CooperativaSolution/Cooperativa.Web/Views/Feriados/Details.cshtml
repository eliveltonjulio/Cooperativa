@model Cooperativa.Models.Feriado
@{ ViewData["Title"] = "Detalhes do feriado"; }
<div class="card p-4">
    <h2 class="mb-3">Detalhes do feriado</h2>
    <dl class="row">
        <dt class="col-sm-3">Data</dt><dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Descrição</dt><dd class="col-sm-9">@Model.Descricao</dd>
        <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Tipo</dd>
    </dl>
    <div class="mt-4 d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a><button type="button" onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</button></div>
</div>
