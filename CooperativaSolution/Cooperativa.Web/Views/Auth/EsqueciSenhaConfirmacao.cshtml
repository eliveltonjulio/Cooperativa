@{
    ViewData["Title"] = "Instruções de Redefinição";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4 text-center">
            <div class="rounded-circle bg-success-subtle text-success d-inline-block p-3 mx-auto mb-3">
                <i class="bi bi-check2-circle fs-1"></i>
            </div>
            <h4 class="fw-bold">Instruções Geradas!</h4>
            <p class="text-muted">
                Um link de redefinição de senha foi gerado para o e-mail cadastrado.
            </p>

            <div class="alert alert-secondary text-start p-3 my-3">
                <small class="text-muted d-block mb-1">Link de redefinição:</small>
                <a href="@ViewBag.LinkRedefinicao" class="fw-semibold text-break">@ViewBag.LinkRedefinicao</a>
            </div>

            <div class="d-flex gap-2 justify-content-center">
                <a href="@ViewBag.LinkRedefinicao" class="btn btn-primary px-4">
                    <i class="bi bi-key me-1"></i>Redefinir Senha Agora
                </a>
                <a asp-action="Login" class="btn btn-outline-secondary px-4">Voltar ao Login</a>
            </div>
        </div>
    </div>
</div>
