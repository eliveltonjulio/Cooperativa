@model Cooperativa.Models.RegistroPonto

@{
    ViewData["Title"] = "Excluir registro de ponto";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Excluir registro de ponto</h2>
        <p class="text-muted mb-0">Confirme a remoção do registro.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<div class="alert alert-warning">
    Tem certeza que deseja excluir o registro de ponto de <strong>@Model.Cooperado?.Nome</strong>?
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p><strong>Data:</strong> @Model.Data.ToString("dd/MM/yyyy")</p>
        <p><strong>Entrada:</strong> @(Model.Entrada?.ToString("HH:mm") ?? "-")</p>
        <p><strong>Saída:</strong> @(Model.Saida?.ToString("HH:mm") ?? "-")</p>
        <p>
            <strong>Ocorrência:</strong>
            @if (Cooperativa.Models.OcorrenciasPonto.ObterPorCodigo(Model.Ocorrencia) is { } ocorrencia)
            {
                <span class="badge bg-info text-dark">@ocorrencia.Codigo — @ocorrencia.Descricao</span>
            }
            else
            {
                <span class="text-muted">Nenhuma</span>
            }
        </p>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
