@model Cooperativa.Web.Models.AlterarSenhaViewModel
@{
    ViewData["Title"] = "Alterar Senha";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <i class="bi bi-key-fill fs-1 text-success"></i>
            <h4 class="fw-bold text-dark mt-2">Alterar senha</h4>
            <p class="text-muted small">Defina uma nova senha para a sua conta</p>
        </div>

        <div class="card border-0 shadow-sm p-4">
            <form asp-action="AlterarSenha" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="SenhaAtual" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input asp-for="SenhaAtual" class="form-control" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="SenhaAtual" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NovaSenha" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                        <input asp-for="NovaSenha" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="NovaSenha" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmarNovaSenha" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                        <input asp-for="ConfirmarNovaSenha" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmarNovaSenha" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success flex-fill py-2 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i>Salvar nova senha
                    </button>
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </div>

        <p class="text-muted small text-center mt-3">
            A senha deve ter no mínimo 6 caracteres. Você permanecerá conectado após a alteração.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}