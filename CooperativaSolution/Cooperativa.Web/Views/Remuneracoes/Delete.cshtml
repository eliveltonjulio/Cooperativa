@model Cooperativa.Models.Remuneracao
@{
    ViewData["Title"] = "Excluir remuneração";
}

<div class="card p-4">
    <h2 class="mb-3">Excluir remuneração</h2>
    <p>Confirma a exclusão da remuneração (contrato <strong>@Model.Contrato?.EmpresaNome</strong>, função <strong>@Model.Funcao?.Nome</strong>)?</p>
    <dl class="row">
        <dt class="col-sm-3">Contrato (empresa)</dt>
        <dd class="col-sm-9">@Model.Contrato?.EmpresaNome</dd>
        <dt class="col-sm-3">Função</dt>
        <dd class="col-sm-9">@Model.Funcao?.Nome</dd>
        <dt class="col-sm-3">Valor</dt>
        <dd class="col-sm-9">
            @Model.Valor.ToString("C")
            @if (Model.TipoRemuneracao == "HORA")
            {
                <span class="text-muted">(por hora)</span>
            }
            else
            {
                <span class="text-muted">(por dia)</span>
            }
        </dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>