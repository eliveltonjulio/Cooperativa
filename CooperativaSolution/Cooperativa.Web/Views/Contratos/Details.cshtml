@model Cooperativa.Models.Contrato
@{
    ViewData["Title"] = "Detalhes do contrato";
}

<div class="card p-4">
    <h2 class="mb-3">Detalhes do contrato</h2>
    <h5 class="text-muted mb-2"><i class="bi bi-buildings me-2"></i>Dados da empresa</h5>
    <dl class="row">
        <dt class="col-sm-3">Nome da empresa</dt>
        <dd class="col-sm-9">@Model.EmpresaNome</dd>
        <dt class="col-sm-3">CNPJ</dt>
        <dd class="col-sm-9">@Model.Cnpj</dd>
    </dl>

    <h5 class="text-muted mb-2"><i class="bi bi-calendar-range me-2"></i>Vigência e valor</h5>
    <dl class="row">
        <dt class="col-sm-3">Data de início</dt>
        <dd class="col-sm-9">@Model.DataInicio.ToShortDateString()</dd>
        <dt class="col-sm-3">Data de fim</dt>
        <dd class="col-sm-9">@(Model.DataFim?.ToShortDateString() ?? "-")</dd>
        <dt class="col-sm-3">Valor</dt>
        <dd class="col-sm-9">@Model.ValorContrato.ToString("C")</dd>
    </dl>

    <h5 class="text-muted mb-2"><i class="bi bi-geo-alt me-2"></i>Endereço</h5>
    <dl class="row">
        <dt class="col-sm-3">Logradouro</dt>
        <dd class="col-sm-9">@Model.Logradouro</dd>
        <dt class="col-sm-3">Bairro</dt>
        <dd class="col-sm-9">@Model.Bairro</dd>
        <dt class="col-sm-3">Cidade</dt>
        <dd class="col-sm-9">@Model.Cidade</dd>
        <dt class="col-sm-3">UF</dt>
        <dd class="col-sm-9">@Model.Uf</dd>
        <dt class="col-sm-3">CEP</dt>
        <dd class="col-sm-9">@Model.Cep</dd>
    </dl>

    <h5 class="text-muted mb-2"><i class="bi bi-person-lines-fill me-2"></i>Contatos</h5>
    <dl class="row">
        <dt class="col-sm-3">Contato 1 - Nome</dt>
        <dd class="col-sm-9">@Model.Contato1Nome</dd>
        <dt class="col-sm-3">Contato 1 - Telefone</dt>
        <dd class="col-sm-9">@Model.Contato1Telefone</dd>
        <dt class="col-sm-3">Contato 2 - Nome</dt>
        <dd class="col-sm-9">@Model.Contato2Nome</dd>
        <dt class="col-sm-3">Contato 2 - Telefone</dt>
        <dd class="col-sm-9">@Model.Contato2Telefone</dd>
    </dl>

    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <button type="button" onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</button>
    </div>
</div>
