@model Cooperativa.Models.TipoAdicional
@{
    ViewData["Title"] = "Editar tipo de adicional";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Editar tipo de adicional</h2>
        <p class="text-muted mb-0">Atualize os dados do adicional.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<form asp-action="Edit" method="post" class="card border-0 shadow-sm p-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="TipoCalculo" class="form-label">Tipo de cálculo</label>
            <select asp-for="TipoCalculo" class="form-select">
                <option value="PERCENTUAL_HORA">Percentual sobre hora</option>
                <option value="VALOR_FIXO">Valor fixo</option>
                <option value="PERCENTUAL_BASE">Percentual sobre base</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Valor" class="form-label"></label>
            <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0" />
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
