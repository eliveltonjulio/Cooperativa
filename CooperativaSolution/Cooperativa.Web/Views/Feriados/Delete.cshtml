@model Cooperativa.Models.Feriado
@{ ViewData["Title"] = "Excluir feriado"; }
<div class="card p-4">
    <h2 class="mb-3">Excluir feriado</h2>
    <p>Confirma a exclusão do feriado <strong>@Model.Descricao</strong> (@Model.Data.ToString("dd/MM/yyyy"))?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-danger">Excluir</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
    </form>
</div>
